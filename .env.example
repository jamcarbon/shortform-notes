# Everything here is optional. shortform-notes picks the first available backend in this order:
#
#   summary     `claude` on PATH, then `codex` on PATH, then OPENAI_API_KEY, then ANTHROPIC_API_KEY, else none
#               (a flat-rate CLI you already pay for beats spending per token)
#   transcript  OPENAI_API_KEY, then faster-whisper if installed (pip install "shortform-notes[local]"), else none
#
# Override the auto-detection with the *_PROVIDER variables or the --summary / --transcribe flags.

# Option A: your own API key
OPENAI_API_KEY=            # transcription (gpt-transcribe) + summaries (gpt-5-mini)
ANTHROPIC_API_KEY=         # summaries with Claude (claude-sonnet-5)

# Option B: no key, using an installed coding-agent CLI
# Nothing to set. If `claude` (Claude Code) or `codex` (OpenAI Codex CLI) is on your PATH
# and logged in, summaries run through it. Pin one explicitly if both are installed:
SHORTFORM_NOTES_SUMMARY_PROVIDER=        # openai | anthropic | claude-code | codex | none | auto
SHORTFORM_NOTES_CLAUDE_CODE_MODEL=       # optional, e.g. sonnet / opus / haiku (default: the CLI's default)
SHORTFORM_NOTES_CODEX_MODEL=             # optional (default: the CLI's default)

# Transcription
SHORTFORM_NOTES_TRANSCRIBE_PROVIDER=     # openai | local | none | auto
SHORTFORM_NOTES_WHISPER_MODEL=base       # local only: tiny | base | small | medium | large-v3
SHORTFORM_NOTES_WHISPER_DEVICE=auto      # local only: auto (GPU if ctranslate2 sees one) | cuda | cpu
                                         # GPU needs cuBLAS/cuDNN: pip install "shortform-notes[cuda]"

# Output
SHORTFORM_NOTES_DIR=reels                # point at your vault, e.g. ~/notes/reels
SHORTFORM_NOTES_AUDIENCE=the reader      # who the summary is written for, e.g. "Jonah, a home cook"

# On-screen text (OCR). Off by default. Downloads the full video and reads sampled frames.
SHORTFORM_NOTES_OCR=0              # 1 to turn on
SHORTFORM_NOTES_OCR_PROVIDER=      # local (free) | openai | anthropic | auto
SHORTFORM_NOTES_OCR_FPS=1          # frames per second, for OCR and vision alike; 0 = every frame.
                                   # Unset, frames are sampled at the video's cuts when ffmpeg is on PATH.
SHORTFORM_NOTES_OCR_OPENAI_MODEL=gpt-5-mini
SHORTFORM_NOTES_OCR_ANTHROPIC_MODEL=claude-sonnet-5

# Vision. Off by default. Tiles the sampled frames into timestamped contact sheets and sends
# them to the summary model itself, so it sees what happens on screen. Works on every summary
# backend except "none" (which makes no call at all); free on claude-code and codex.
SHORTFORM_NOTES_VISION=0           # 1 to turn on; at most 48 frames per video, 16 to a sheet
                                   # Defaults to 1 when Notion is configured (screenshots need it).

# Categories: each video gets exactly one. Comma-separated; Notion select options cannot contain commas.
SHORTFORM_NOTES_CATEGORIES=        # empty = built-in list (Cooking & Recipes, Fitness & Health, Tech & Software, AI, ...)

# Notion (optional). Create an internal integration at https://www.notion.so/profile/integrations,
# share the database with it (••• → Connections), then paste the secret and the database link or id.
NOTION_TOKEN=                      # ntn_... / secret_...
NOTION_DATABASE_ID=                # the id, or the full https://www.notion.so/... link
NOTION_VERSION=                    # optional; default 2026-03-11
